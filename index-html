
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>THE FALL</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="game-container">
        <header>
            <h1>THE FALL</h1>
            <p>Every fall is another chance to rise.</p>
        </header>

        <div class="hud">
            <span id="checkpoint">Checkpoint: Base Camp</span>
            <span id="falls">Falls: 0</span>
            <span id="resolve">Resolve: 0</span>
        </div>

        <div class="canvas-container">
            <canvas id="gameCanvas" width="960" height="540"></canvas>

            <div id="startScreen" class="screen">
                <h2>THE FALL</h2>
                <p>You fell once. Now climb again.</p>
                <button id="startButton">START CLIMBING</button>
            </div>

            <div id="winScreen" class="screen hidden">
                <h2>YOU MADE IT!</h2>
                <p>The fall didn't define you. Getting back up did.</p>
                <button id="restartButton">PLAY AGAIN</button>
            </div>
        </div>

        <div class="controls">
            <p><strong>MOVE:</strong> A / D or Arrow Keys</p>
            <p><strong>JUMP:</strong> Space / W / Up Arrow</p>
        </div>

        <footer>
            THE FALL — A game about resilience.
        </footer>
    </div>

    <script src="game.js"></script>
</body>
</html>
